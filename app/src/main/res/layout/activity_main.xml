<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/form_background"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/form_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="beforeDescendants"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:contentDescription="Auvious company logo"
                android:src="@drawable/auvious_logo"
                android:tag="appLogo"
                app:tint="?android:colorPrimary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/title"
                style="@style/TextAppearance.MaterialComponents.Headline6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Video calls &amp; Co-browse for CX."
                android:textAlignment="center" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/sdk_version"
                style="@style/TextAppearance.MaterialComponents.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textColor="@color/form_secondary_text"
                tools:text="SDK v1.1.2" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/mode_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:checkedButton="@id/mode_video_call"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mode_video_call"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="Video call mode"
                    android:textAllCaps="false"
                    android:tag="modeVideoCallButton"
                    android:text="Video call" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mode_cobrowse"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="Co-browse mode"
                    android:textAllCaps="false"
                    android:tag="modeCobrowseButton"
                    android:text="Co-browse" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Shown in both modes -->

            <TextView
                style="@style/FormSectionHeader"
                android:text="Session" />

            <com.google.android.material.card.MaterialCardView style="@style/FormCard">

                <LinearLayout
                    style="@style/FormCardContent"
                    android:paddingTop="8dp"
                    android:paddingBottom="0dp"
                    android:showDividers="none">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ticket"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ticket"
                        app:helperText="Required">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ticket_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="Ticket input field"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:tag="ticketInputField"
                            tools:text="123" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/participant_name"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Name"
                        app:helperText="Optional">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/participant_name_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="Participant name input field"
                            android:imeOptions="actionDone"
                            android:inputType="textPersonName|textCapWords"
                            android:tag="participantNameInputField" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="52dp">

                        <TextView
                            android:id="@+id/server_url_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Environment"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/server_url_button"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:contentDescription="Server URL selection button"
                            android:gravity="end|center_vertical"
                            android:maxLines="1"
                            android:tag="serverUrlButton"
                            android:textAllCaps="false"
                            app:icon="@drawable/ic_arrow_drop_down"
                            app:iconGravity="end"
                            tools:text="auvious.video" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Video call only -->

            <LinearLayout
                android:id="@+id/call_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/FormSectionHeader"
                    android:text="Call" />

                <com.google.android.material.card.MaterialCardView style="@style/FormCard">

                    <LinearLayout style="@style/FormCardContent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="52dp">

                            <TextView
                                android:id="@+id/call_mode_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Call mode"
                                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/call_mode_button"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:contentDescription="Call mode selection button"
                                android:gravity="end|center_vertical"
                                android:maxLines="1"
                                android:tag="callModeButton"
                                android:textAllCaps="false"
                                app:icon="@drawable/ic_arrow_drop_down"
                                app:iconGravity="end"
                                tools:text="Audio + video" />

                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/speaker_switch"
                            style="@style/FormSwitch"
                            android:checked="false"
                            android:contentDescription="Use earpiece speaker toggle"
                            android:tag="earpieceSpeakerSwitch"
                            android:text="Use earpiece speaker" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/conference_background_switch"
                            style="@style/FormSwitch"
                            android:checked="false"
                            android:contentDescription="Custom conference background toggle"
                            android:tag="conferenceBackgroundSwitch"
                            android:text="Custom conference background" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/call_entire_screen_share_switch"
                            style="@style/FormSwitch"
                            android:checked="false"
                            android:contentDescription="Allow entire screen share toggle"
                            android:tag="callEntireScreenShareSwitch"
                            android:text="Allow entire screen share" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/call_cobrowse_switch"
                            style="@style/FormSwitch"
                            android:checked="false"
                            android:contentDescription="Allow co-browse in the call toggle"
                            android:tag="callCobrowseSwitch"
                            android:text="Allow co-browse in the call (uses the co-browse masking options)" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/call_ar_pointer_switch"
                            style="@style/FormSwitch"
                            android:checked="true"
                            android:contentDescription="Allow AR pointer toggle"
                            android:tag="callArPointerSwitch"
                            android:text="Allow AR pointer (the agent points and draws on your camera or shared screen)" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/FormSectionHeader"
                    android:text="Call controls" />

                <com.google.android.material.card.MaterialCardView style="@style/FormCard">

                    <LinearLayout style="@style/FormCardContent">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/camera_available_switch"
                            style="@style/FormSwitch"
                            android:checked="true"
                            android:contentDescription="Camera button availability toggle"
                            android:tag="cameraAvailableSwitch"
                            android:text="Camera" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/mic_available_switch"
                            style="@style/FormSwitch"
                            android:checked="true"
                            android:contentDescription="Microphone button availability toggle"
                            android:tag="micAvailableSwitch"
                            android:text="Microphone" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/speaker_available_switch"
                            style="@style/FormSwitch"
                            android:checked="true"
                            android:contentDescription="Speaker button availability toggle"
                            android:tag="speakerAvailableSwitch"
                            android:text="Speaker" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/pip_available_switch"
                            style="@style/FormSwitch"
                            android:checked="true"
                            android:contentDescription="Picture-in-Picture button availability toggle"
                            android:tag="pipAvailableSwitch"
                            android:text="Picture in picture" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/screen_share_available_switch"
                            style="@style/FormSwitch"
                            android:checked="true"
                            android:contentDescription="Screen share button availability toggle"
                            android:tag="screenShareAvailableSwitch"
                            android:text="Screen sharing" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/FormSectionFooter"
                    android:text="Buttons available during the call." />

                <TextView
                    style="@style/FormSectionHeader"
                    android:text="Permissions" />

                <com.google.android.material.card.MaterialCardView style="@style/FormCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/request_camera_perm"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:contentDescription="Request camera permission button"
                            android:tag="requestCameraPermButton"
                            android:text="Camera" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/request_mic_perm"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:contentDescription="Request microphone permission button"
                            android:tag="requestMicPermButton"
                            android:text="Microphone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/request_storage_perm"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:contentDescription="Request storage permission button"
                            android:tag="requestStoragePermButton"
                            android:text="Storage" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/FormSectionFooter"
                    android:text="Camera and microphone are required to join a call." />

            </LinearLayout>

            <!-- Co-browse only -->

            <LinearLayout
                android:id="@+id/cobrowse_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/FormSectionHeader"
                    android:text="Sharing" />

                <com.google.android.material.card.MaterialCardView style="@style/FormCard">

                    <LinearLayout style="@style/FormCardContent">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/entire_screen_share_switch"
                            style="@style/FormSwitch"
                            android:contentDescription="Allow entire screen share toggle"
                            android:tag="entireScreenShareSwitch"
                            android:text="Allow entire screen" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/FormSectionFooter"
                    android:text="On: the entire screen may be shared, and sharing goes on outside the app, without masks. Off: only this app is shared; on Android 14+ an entire-screen share stops once you leave the app. Another app is never allowed." />

                <TextView
                    style="@style/FormSectionHeader"
                    android:text="Masking" />

                <com.google.android.material.card.MaterialCardView style="@style/FormCard">

                    <LinearLayout style="@style/FormCardContent">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/mask_marked_views_switch"
                            style="@style/FormSwitch"
                            android:contentDescription="Mask marked views toggle"
                            android:tag="maskMarkedViewsSwitch"
                            android:text="Marked views (auviousMasked)" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/mask_identifiers_switch"
                            style="@style/FormSwitch"
                            android:contentDescription="Mask by identifier toggle"
                            android:tag="maskIdentifiersSwitch"
                            android:text="Identifiers (id / tag)" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/mask_classes_switch"
                            style="@style/FormSwitch"
                            android:contentDescription="Mask by view class toggle"
                            android:tag="maskClassesSwitch"
                            android:text="View classes" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/mask_secure_fields_switch"
                            style="@style/FormSwitch"
                            android:contentDescription="Mask password fields toggle"
                            android:tag="maskSecureFieldsSwitch"
                            android:text="Mask password fields" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/mask_all_text_inputs_switch"
                            style="@style/FormSwitch"
                            android:contentDescription="Mask all text inputs toggle"
                            android:tag="maskAllTextInputsSwitch"
                            android:text="Mask all text inputs" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/mask_hints_switch"
                            style="@style/FormSwitch"
                            android:contentDescription="Show mask hints toggle"
                            android:tag="maskHintsSwitch"
                            android:text="Show mask hints" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/debug_masks_switch"
                            style="@style/FormSwitch"
                            android:contentDescription="Highlight masks debug toggle"
                            android:tag="debugMasksSwitch"
                            android:text="Highlight masks (debug)" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/FormSectionFooter"
                    android:text="Masked views are blacked out for the agent. Each rule can be turned off to see what it masks in the sample form. Hints outline masked views on your screen; highlight also labels the rule that matched." />

                <TextView
                    style="@style/FormSectionHeader"
                    android:text="Permissions" />

                <com.google.android.material.card.MaterialCardView style="@style/FormCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/request_notifications_perm"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:contentDescription="Request notifications permission button"
                            android:tag="requestNotificationsPermButton"
                            android:text="Notifications" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/FormSectionFooter"
                    android:text="Lets the screen-sharing notification show while you share." />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Keeps the action button above the navigation bar, and above the keyboard while typing -->
    <FrameLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/form_background"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/join_call"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:contentDescription="Join conference call button"
            android:tag="joinCallButton"
            android:text="Join call"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
            app:cornerRadius="28dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
